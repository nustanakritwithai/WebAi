# ============================================================
# HOST A — VPS SECRET PROXY ONLY (server/index.mjs)
# ============================================================
TYPHOON_API_KEY=replace_me
TYPHOON_BASE_URL=https://api.opentyphoon.ai/v1
TYPHOON_MODEL=typhoon-v2.5-30b-a3b-instruct
PORT=8787
ALLOWED_ORIGINS=https://nustanakritwithai.github.io,http://localhost:8000,http://127.0.0.1:8000
WEB_AUTH_TOKEN=

# IMPORTANT: do NOT configure workspace, task state, worker, or verification on the VPS proxy.

# ============================================================
# HOST B — WEBAI CORE / WORKER HOST (server/core.mjs)
# ============================================================
CORE_PORT=8790
CORE_ALLOWED_ORIGINS=https://nustanakritwithai.github.io,http://localhost:8000,http://127.0.0.1:8000

# Core reaches OpenTyphoon only through Host A; no provider API key lives here.
TYPHOON_PROXY_BASE_URL=https://proxy.example.com
TYPHOON_PROXY_TOKEN=

# Signed owner sessions. Use strong random values in the real host secret store.
WEBAI_CORE_PAIRING_TOKEN=replace_with_strong_pairing_token
WEBAI_CORE_SESSION_SECRET=replace_with_at_least_32_random_bytes
WEBAI_CORE_SESSION_TTL_SECONDS=43200

# Native execution and per-owner persistent task state.
WEBAI_WORKSPACE=/srv/webai-worker/workspace
WEBAI_NATIVE_WORKER_ENABLED=true
WEBAI_CORE_STATE_DIR=/srv/webai-worker/state/owners

# Future Core services (not VPS proxy capabilities)
ECC_ENABLED=false
ECC_ROOT=/srv/webai-worker/ecc
HERMES_ENABLED=false
HERMES_HOME=/srv/webai-worker/hermes
HARPOON_ENABLED=false
HARPOON_URL=http://127.0.0.1:9000
PREVIEW_ENABLED=false
PREVIEW_BASE_URL=http://127.0.0.1:4173

# BrowserPod / Browser Linux / OMP are not part of this architecture.
# Never commit real secrets. This file contains placeholders only.
