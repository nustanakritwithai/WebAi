# OpenTyphoon primary provider
TYPHOON_API_KEY=replace_with_your_server_side_key
TYPHOON_BASE_URL=https://api.opentyphoon.ai/v1
TYPHOON_MODEL=typhoon-v2.5-30b-a3b-instruct

# WebAi API server
PORT=8787
ALLOWED_ORIGINS=https://nustanakritwithai.github.io
WEB_AUTH_TOKEN=replace_with_a_random_control_token
WEBAI_WORKSPACE=/path/to/allowed/project/workspace

# OMP RPC bridge (enable only on a trusted backend host with OMP installed)
OMP_ENABLED=false
OMP_COMMAND=omp
OMP_PROVIDER=opentyphoon
OMP_MODEL=typhoon-v2.5-30b-a3b-instruct

# Never expose TYPHOON_API_KEY or WEB_AUTH_TOKEN in client-side source.
