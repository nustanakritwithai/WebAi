# OpenTyphoon
TYPHOON_API_KEY=replace_me
TYPHOON_BASE_URL=https://api.opentyphoon.ai/v1
TYPHOON_MODEL=typhoon-v2.5-30b-a3b-instruct

# WebAi server / secure proxy
PORT=8787
ALLOWED_ORIGINS=https://nustanakritwithai.github.io,http://localhost:8000,http://127.0.0.1:8000
WEB_AUTH_TOKEN=
WEBAI_WORKSPACE=/srv/webai/workspace

# OMP coding worker
OMP_ENABLED=false
OMP_COMMAND=omp
OMP_PROVIDER=opentyphoon
OMP_MODEL=typhoon-v2.5-30b-a3b-instruct

# Supervised agent state (created with restrictive file permissions)
AGENT_STATE_PATH=/srv/webai/state/agent-state.json

# ECC engineering layer
ECC_ENABLED=false
ECC_ROOT=/srv/webai/ecc

# Hermes memory
HERMES_ENABLED=false
HERMES_HOME=/srv/webai/hermes

# OpenClaw communication
OPENCLAW_ENABLED=false
OPENCLAW_URL=http://127.0.0.1:18789

# Harpoon performance verification
HARPOON_ENABLED=false
HARPOON_URL=http://127.0.0.1:9000

# Live Preview channel
PREVIEW_ENABLED=false
PREVIEW_BASE_URL=http://127.0.0.1:4173

# Never put real secrets in this file. Use a VPS-local .env or secret store.
