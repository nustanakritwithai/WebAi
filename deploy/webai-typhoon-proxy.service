[Unit]
Description=WebAi secure OpenTyphoon proxy
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=webai
Group=webai
WorkingDirectory=/opt/webai
EnvironmentFile=/etc/webai/typhoon-proxy.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/webai/server/index.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
